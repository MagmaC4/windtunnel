[Unit]
Description=Standby (On / Off Sensor) Database Service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ventus/Projects/windtunnel/microcontrollers
ExecStart=/usr/bin/docker compose up -d standby
ExecStop=/usr/bin/docker compose down standby

[Install]
WantedBy=multi-user.target