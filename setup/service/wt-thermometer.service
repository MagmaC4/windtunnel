[Unit]
Description=Thermometer (Temperature Sensor) Database Service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ventus/Projects/windtunnel/microcontrollers
ExecStart=/usr/bin/docker compose up -d thermometer
ExecStop=/usr/bin/docker compose down thermometer

[Install]
WantedBy=multi-user.target