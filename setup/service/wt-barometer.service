[Unit]
Description=Barometer (Pressure Sensor) Database Service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ventus/Projects/windtunnel/microcontrollers
ExecStart=/usr/bin/docker compose up -d barometer
ExecStop=/usr/bin/docker compose down barometer

[Install]
WantedBy=multi-user.target